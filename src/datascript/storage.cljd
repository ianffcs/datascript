(ns datascript.storage
  (:require
   ["dart:async" :as dart:async]
   ["dart:isolate" :as dart:isolate]
   [cljd.dart.isolates :as di]
   [datascript.db :as db]
   [datascript.pull-api :as pull-api]
   [datascript.query :as q]
   [me.tonsky.persistent-sorted-set :as set]))

(defprotocol IStorage
  (-store [_ addr+data-seq])
  (-restore [_ addr])
  (-list-addresses [_])
  (-delete [_ addrs-seq]))

(defn maybe-adapt-storage [opts]
  opts)

(defn storage [db]
  (get db ::storage))

(defn attach-storage [db s]
  (assoc db ::storage s))

(def ^:private root-addr 0)
(def ^:private tail-addr 1)

(defonce ^:private *max-addr (volatile! 1000000))

(defn- gen-addr []
  (vswap! *max-addr inc))

(defn serializable-datom [^db/Datom d]
  [(.-e d) (.-a d) (.-v d) (.-tx d)])

(defn- restore-datom [[e a v tx]]
  (db/datom e a v tx))

(defn- store-node! [node level *buf]
  (let [node-keys (mapv serializable-datom (.-keys node))]
    (if (== 0 level)
      (let [addr (gen-addr)]
        (vswap! *buf conj! [addr {:keys node-keys}])
        (dart/await addr))
      (let [addrs (dart/await
                    (dart:async/Future.wait
                      (mapv #(store-node! % (dec level) *buf) (.-pointers node))))
            addr  (gen-addr)]
        (vswap! *buf conj! [addr {:keys node-keys :addresses addrs}])
        (dart/await addr)))))

(defn store-impl!
  ([db s]
   (dart/await (store-impl! db s false)))
  ([db s _force?]
   (let [{:keys [eavt aevt avet schema max-eid max-tx]} db
         *buf      (volatile! (transient []))
         eavt-addr (dart/await (store-node! (.-root eavt) (.-shift eavt) *buf))
         aevt-addr (dart/await (store-node! (.-root aevt) (.-shift aevt) *buf))
         avet-addr (dart/await (store-node! (.-root avet) (.-shift avet) *buf))
         root-data {:schema   schema
                    :max-eid  max-eid
                    :max-tx   max-tx
                    :max-addr @*max-addr
                    :eavt {:root-addr eavt-addr :shift (.-shift eavt) :cnt (.-cnt eavt)}
                    :aevt {:root-addr aevt-addr :shift (.-shift aevt) :cnt (.-cnt aevt)}
                    :avet {:root-addr avet-addr :shift (.-shift avet) :cnt (.-cnt avet)}}]
     (vswap! *buf conj! [root-addr root-data])
     (vswap! *buf conj! [tail-addr []])
     (dart/await (-store s (persistent! @*buf)))
     db)))

(defn store
  ([db]
   (if-some [s (storage db)]
     (dart/await (store-impl! db s false))
     (throw (ex-info "Database has no associated storage" {}))))
  ([db s]
   (dart/await (store-impl! db s false))))

(defn- load-node [s data]
  (let [{:keys [keys addresses]} data
        real-keys (to-array (map restore-datom keys))]
    (if addresses
      (let [children (dart/await
                       (dart:async/Future.wait
                         (mapv (fn [addr]
                                 (dart/await (load-node s (dart/await (-restore s addr)))))
                           addresses)))]
        (set/->Node real-keys (to-array children)))
      (set/->Leaf real-keys))))

(defn- load-btset [s root-addr shift cnt cmp]
  (when-some [root-data (dart/await (-restore s root-addr))]
    (set/->BTSet (dart/await (load-node s root-data)) shift cnt cmp nil nil)))

(defn restore-impl
  ([s]
   (dart/await (restore-impl s {})))
  ([s _opts]
   (when-some [{:keys [schema max-eid max-tx max-addr eavt aevt avet]}
               (dart/await (-restore s root-addr))]
     (vswap! *max-addr max max-addr)
     (let [tail (dart/await (-restore s tail-addr))
           db (db/restore-db
                {:schema schema
                 :eavt (dart/await (load-btset s (:root-addr eavt) (:shift eavt) (:cnt eavt) db/cmp-datoms-eavt))
                 :aevt (dart/await (load-btset s (:root-addr aevt) (:shift aevt) (:cnt aevt) db/cmp-datoms-aevt))
                 :avet (dart/await (load-btset s (:root-addr avet) (:shift avet) (:cnt avet) db/cmp-datoms-avet))
                 :max-eid max-eid
                 :max-tx max-tx})]
       [db (mapv #(mapv restore-datom %) (or tail []))]))))

(defn db-with-tail [db tail]
  (reduce
    (fn [db datoms]
      (if (empty? datoms)
        db
        (as-> db %
          (reduce db/with-datom % datoms)
          (assoc % :max-tx (:tx (first datoms))))))
    db
    tail))

(defn- store-tail* [s tail]
  (dart/await
    (-store s [[tail-addr (mapv #(mapv serializable-datom %) tail)]])))

(defn store-tail [db tail]
  (if-some [s (storage db)]
    (dart/await (store-tail* s tail))
    (throw (ex-info "Database has no associated storage" {}))))

(defn- transact-report [db tx-data tx-meta]
  (db/transact-tx-data (db/->TxReport db db [] {} tx-meta) tx-data))

(defn- dispatch [*conn *tx-tail s [op args ^dart:isolate/SendPort reply]]
  (case op
    :transact
    (let [[tx-data tx-meta] args
          report (transact-report @*conn tx-data tx-meta)
          db (:db-after report)
          tail' (swap! *tx-tail conj (:tx-data report))]
      (reset! *conn db)
      (if (> (transduce (map count) + 0 tail')
             set/max-len)
        (do
          (dart/await (store-impl! db s false))
          (reset! *tx-tail []))
        (dart/await (store-tail* s tail')))
      (.send reply :ok))

    :q
    (let [[query & inputs] args]
      (.send reply
        (mapv #(if (db/datom? %) (serializable-datom %) %)
          (apply q/q query @*conn inputs))))

    :datoms
    (let [[index & components] args]
      (.send reply
        (mapv serializable-datom
          (apply db/-datoms @*conn index components))))

    :pull
    (let [[pattern id] args]
      (.send reply (pull-api/pull @*conn pattern id)))

    :db-after
    (.send reply nil)

    :store
    (do
      (dart/await (store-impl! @*conn s false))
      (reset! *tx-tail [])
      (.send reply :ok))))

(defn- db-isolate-fn
  [make-storage schema opts]
  (fn [{:keys [in]}]
    (let [s                       (make-storage)
          [stored-db stored-tail] (or (dart/await (restore-impl s opts)) [nil []])
          conn  (atom (if stored-db
                        (db-with-tail stored-db stored-tail)
                        (db/empty-db schema opts)))
          *tail (atom (or stored-tail []))]
      (.listen ^dart:isolate/ReceivePort in
        (fn [msg] (dart/await (dispatch conn *tail s msg)))))))

(defn spawn-db!
  ([make-storage] (spawn-db! make-storage nil {}))
  ([make-storage schema] (spawn-db! make-storage schema {}))
  ([make-storage schema opts]
   (dart/await
     (let [{:keys [ports]} (dart/await (di/spawn! (db-isolate-fn make-storage schema opts)))]
       (:in ports)))))
