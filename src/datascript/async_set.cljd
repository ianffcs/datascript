(ns datascript.async-set
  (:require
    [me.tonsky.persistent-sorted-set.arrays :as arrays])
  (:import (datascript.async_set AsyncLazyNode)))

;; Async, lazily-loading B+ tree for DataScript storage.
;; Node operations use dart/await, allowing nodes to be loaded from
;; async IStorage on demand. Each AsyncLazyNode carries its own load-fn
;; so the set itself needs no extra context.

(def max-len 32)
(def min-len 16)

;; ---- Pure array helpers (mirrors PSS private fns) ----

(defn- binary-search-l [cmp arr r k]
  (loop [l 0
         r (int r)]
    (if (<= l r)
      (let [m  (arrays/half (+ l r))
            mk (arrays/aget arr m)]
        (if (neg? (cmp mk k))
          (recur (inc m) r)
          (recur l (dec m))))
      l)))

(defn- lookup-exact [cmp arr key]
  (let [arr-l (arrays/alength arr)
        idx   (binary-search-l cmp arr (dec arr-l) key)]
    (if (and (< idx arr-l)
             (== 0 (cmp (arrays/aget arr idx) key)))
      idx
      -1)))

(defn- lookup-range [cmp arr key]
  (let [arr-l (arrays/alength arr)
        idx   (binary-search-l cmp arr (dec arr-l) key)]
    (if (== idx arr-l)
      -1
      idx)))

(defn- cut-n-splice [arr cut-from cut-to splice-from splice-to xs]
  (let [xs-l    (arrays/alength xs)
        l1      (- splice-from cut-from)
        l2      (- cut-to splice-to)
        l1xs    (+ l1 xs-l)
        new-arr (arrays/make-array (+ l1 xs-l l2))]
    (arrays/acopy arr cut-from  splice-from new-arr 0)
    (arrays/acopy xs  0         xs-l        new-arr l1)
    (arrays/acopy arr splice-to cut-to      new-arr l1xs)
    new-arr))

(defn- splice [arr splice-from splice-to xs]
  (cut-n-splice arr 0 (arrays/alength arr) splice-from splice-to xs))

(defn- merge-n-split [a1 a2]
  (let [a1-l    (arrays/alength a1)
        a2-l    (arrays/alength a2)
        total-l (+ a1-l a2-l)
        r1-l    (arrays/half total-l)
        r2-l    (- total-l r1-l)
        r1      (arrays/make-array r1-l)
        r2      (arrays/make-array r2-l)]
    (if (<= a1-l r1-l)
      (do
        (arrays/acopy a1 0              a1-l          r1 0)
        (arrays/acopy a2 0              (- r1-l a1-l) r1 a1-l)
        (arrays/acopy a2 (- r1-l a1-l) a2-l          r2 0))
      (do
        (arrays/acopy a1 0    r1-l r1 0)
        (arrays/acopy a1 r1-l a1-l r2 0)
        (arrays/acopy a2 0    a2-l r2 (- a1-l r1-l))))
    (arrays/array r1 r2)))

(defn- ^bool eq-arr [cmp a1 a1-from a1-to a2 a2-from a2-to]
  (let [len (- a1-to a1-from)]
    (and
      (== len (- a2-to a2-from))
      (loop [i 0]
        (cond
          (== i len)
          true

          (not (== 0 (cmp
                       (arrays/aget a1 (+ i a1-from))
                       (arrays/aget a2 (+ i a2-from)))))
          false

          :else
          (recur (inc i)))))))

(defn- check-n-splice [cmp arr from to new-arr]
  (if (eq-arr cmp arr from to new-arr 0 (arrays/alength new-arr))
    arr
    (splice arr from to new-arr)))

(defn- return-array
  ([a1]
   (arrays/array a1))
  ([a1 a2]
   (if a1
     (if a2
       (arrays/array a1 a2)
       (arrays/array a1))
     (arrays/array a2)))
  ([a1 a2 a3]
   (if a1
     (if a2
       (if a3
         (arrays/array a1 a2 a3)
         (arrays/array a1 a2))
       (if a3
         (arrays/array a1 a3)
         (arrays/array a1)))
     (if a2
       (if a3
         (arrays/array a2 a3)
         (arrays/array a2))
       (arrays/array a3)))))

;; ---- IAsyncNode protocol ----

(defprotocol IAsyncNode
  ;; Returns Future<concrete-AsyncNode|AsyncLeaf>. Lazy nodes load from storage;
  ;; concrete nodes return self.
  (async-node-materialize [_])
  ;; Sync accessors — valid on concrete nodes and AsyncLazyNode (uses cached metadata).
  (node-lim-key [_])
  (node-len     [_])
  ;; Async structural ops — return new node(s), not Futures of sets.
  (async-node-merge         [_ next])
  (async-node-merge-n-split [_ next])
  (async-node-lookup        [_ cmp key])
  (async-node-conj          [_ cmp key])
  (async-node-disj          [_ cmp key root? left right])
  (async-node-slice-into    [_ cmp key-from key-to acc]))

;; ---- Rotate (mirrors PSS rotate, but materializes before merge) ----

(defn- materialize [node]
  (when node
    (dart/await (async-node-materialize node))))

(defn- rotate [node root? left right]
  (let [node (dart/await (materialize node))]
    (cond
      root?
      (return-array node)

      (> (node-len node) min-len)
      (return-array left node right)

      :else
      (let [left  (when left  (dart/await (materialize left)))
            right (when right (dart/await (materialize right)))]
        (cond
          (and left (<= (node-len left) min-len))
          (return-array (async-node-merge left node) right)

          (and right (<= (node-len right) min-len))
          (return-array left (async-node-merge node right))

          (and left (or (nil? right)
                        (< (node-len left) (node-len right))))
          (let [nodes (async-node-merge-n-split left node)]
            (return-array (arrays/aget nodes 0) (arrays/aget nodes 1) right))

          :else
          (let [nodes (async-node-merge-n-split node right)]
            (return-array left (arrays/aget nodes 0) (arrays/aget nodes 1))))))))

;; ---- Concrete inner node ----

(deftype AsyncNode [keys pointers]
  IAsyncNode
  (async-node-materialize [this] this)

  (node-lim-key [_] (arrays/alast keys))
  (node-len     [_] (arrays/alength keys))

  (async-node-merge [_ next]
    (AsyncNode. (arrays/aconcat keys     (.-keys next))
                (arrays/aconcat pointers (.-pointers next))))

  (async-node-merge-n-split [_ next]
    (let [ks (merge-n-split keys     (.-keys next))
          ps (merge-n-split pointers (.-pointers next))]
      (return-array (AsyncNode. (arrays/aget ks 0) (arrays/aget ps 0))
                    (AsyncNode. (arrays/aget ks 1) (arrays/aget ps 1)))))

  (async-node-lookup [_ cmp key]
    (let [idx (lookup-range cmp keys key)]
      (when-not (== -1 idx)
        (dart/await (async-node-lookup (arrays/aget pointers idx) cmp key)))))

  (async-node-conj [_ cmp key]
    (let [idx   (binary-search-l cmp keys (- (arrays/alength keys) 2) key)
          nodes (dart/await (async-node-conj (arrays/aget pointers idx) cmp key))]
      (when nodes
        (let [new-keys     (check-n-splice cmp keys     idx (inc idx) (arrays/amap node-lim-key nodes))
              new-pointers (splice             pointers idx (inc idx) nodes)]
          (let [ptrs-l (arrays/alength new-pointers)]
            (if (<= ptrs-l max-len)
              (arrays/array (AsyncNode. new-keys new-pointers))
              (let [middle (arrays/half ptrs-l)]
                (arrays/array
                  (AsyncNode. (.sublist new-keys     0 middle)
                              (.sublist new-pointers 0 middle))
                  (AsyncNode. (.sublist new-keys     middle)
                              (.sublist new-pointers middle))))))))))

  (async-node-disj [_ cmp key root? left right]
    (let [idx (lookup-range cmp keys key)]
      (when-not (== -1 idx)
        (let [child       (arrays/aget pointers idx)
              left-child  (when (pos? idx)
                            (arrays/aget pointers (dec idx)))
              right-child (when (< (inc idx) (arrays/alength pointers))
                            (arrays/aget pointers (inc idx)))
              disjned     (dart/await (async-node-disj child cmp key false left-child right-child))]
          (when disjned
            (let [left-idx     (if left-child  (dec idx)   idx)
                  right-idx    (if right-child (+ 2 idx)   (+ 1 idx))
                  new-keys     (check-n-splice cmp keys     left-idx right-idx (arrays/amap node-lim-key disjned))
                  new-pointers (splice             pointers left-idx right-idx disjned)]
              (dart/await (rotate (AsyncNode. new-keys new-pointers) root? left right))))))))

  (async-node-slice-into [_ cmp key-from key-to acc]
    (let [pointers-l (arrays/alength pointers)]
      (loop [i   0
             acc acc]
        (if (>= i pointers-l)
          acc
          (let [max-key (arrays/aget keys i)]
            (if (and key-from (neg? (cmp max-key key-from)))
              (recur (inc i) acc)
              (let [acc (dart/await (async-node-slice-into (arrays/aget pointers i) cmp key-from key-to acc))]
                (if (and key-to (pos? (cmp max-key key-to)))
                  acc
                  (recur (inc i) acc))))))))))

;; ---- Concrete leaf node ----

(deftype AsyncLeaf [keys]
  IAsyncNode
  (async-node-materialize [this] this)

  (node-lim-key [_] (arrays/alast keys))
  (node-len     [_] (arrays/alength keys))

  (async-node-merge [_ next]
    (AsyncLeaf. (arrays/aconcat keys (.-keys next))))

  (async-node-merge-n-split [_ next]
    (let [ks (merge-n-split keys (.-keys next))]
      (return-array (AsyncLeaf. (arrays/aget ks 0))
                    (AsyncLeaf. (arrays/aget ks 1)))))

  (async-node-lookup [_ cmp key]
    (let [idx (lookup-exact cmp keys key)]
      (when-not (== -1 idx)
        (arrays/aget keys idx))))

  (async-node-conj [_ cmp key]
    (let [idx    (binary-search-l cmp keys (dec (arrays/alength keys)) key)
          keys-l (arrays/alength keys)]
      (cond
        (and (< idx keys-l)
             (== 0 (cmp key (arrays/aget keys idx))))
        nil

        (== keys-l max-len)
        (let [middle (arrays/half (inc keys-l))]
          (if (> idx middle)
            (arrays/array
              (AsyncLeaf. (.sublist keys 0 middle))
              (AsyncLeaf. (cut-n-splice keys middle keys-l idx idx (arrays/array key))))
            (arrays/array
              (AsyncLeaf. (cut-n-splice keys 0 middle idx idx (arrays/array key)))
              (AsyncLeaf. (.sublist keys middle keys-l)))))

        :else
        (arrays/array (AsyncLeaf. (splice keys idx idx (arrays/array key)))))))

  (async-node-disj [_ cmp key root? left right]
    (let [idx (lookup-exact cmp keys key)]
      (when-not (== -1 idx)
        (let [new-keys (splice keys idx (inc idx) (arrays/array))]
          (dart/await (rotate (AsyncLeaf. new-keys) root? left right))))))

  (async-node-slice-into [_ cmp key-from key-to acc]
    (let [keys-l (arrays/alength keys)]
      (loop [i   0
             acc acc]
        (if (>= i keys-l)
          acc
          (let [k (arrays/aget keys i)]
            (cond
              (and key-from (neg? (cmp k key-from)))
              (recur (inc i) acc)

              (and key-to (pos? (cmp k key-to)))
              acc

              :else
              (recur (inc i) (conj! acc k)))))))))

;; ---- Lazy node (loads from storage on first access) ----

(deftype AsyncLazyNode [address lim-key len load-fn ^:mutable cached]
  IAsyncNode
  (async-node-materialize [_]
    (or cached
        (let [loaded (dart/await (load-fn address))]
          (set! cached loaded)
          loaded)))

  ;; lim-key and len are known from parent without loading — used in rotate
  (node-lim-key [_] lim-key)
  (node-len     [_] len)

  (async-node-merge [this next]
    (dart/await (async-node-merge (dart/await (async-node-materialize this)) next)))

  (async-node-merge-n-split [this next]
    (dart/await (async-node-merge-n-split (dart/await (async-node-materialize this)) next)))

  (async-node-lookup [this cmp key]
    (dart/await (async-node-lookup (dart/await (async-node-materialize this)) cmp key)))

  (async-node-conj [this cmp key]
    (dart/await (async-node-conj (dart/await (async-node-materialize this)) cmp key)))

  (async-node-disj [this cmp key root? left right]
    (dart/await (async-node-disj (dart/await (async-node-materialize this)) cmp key root? left right)))

  (async-node-slice-into [this cmp key-from key-to acc]
    (dart/await (async-node-slice-into (dart/await (async-node-materialize this)) cmp key-from key-to acc))))

;; ---- AsyncBTSet ----

(deftype AsyncBTSet [root cnt comparator])

;; ---- Constructors ----

(defn async-lazy-node
  "Create a lazy node that loads from storage on demand.
   lim-key and len must be known from the parent's stored metadata."
  [address lim-key len load-fn]
  (AsyncLazyNode. address lim-key len load-fn nil))

(defn async-sorted-set
  ([]    (AsyncBTSet. (AsyncLeaf. (arrays/array)) 0 compare))
  ([cmp] (AsyncBTSet. (AsyncLeaf. (arrays/array)) 0 cmp)))

;; ---- Public async operations ----
(defn async-conj
  ([set key]
   (dart/await (async-conj set key (.-comparator set))))
  ([set key cmp]
   (let [roots (dart/await (async-node-conj (.-root set) cmp key))
         cnt   (.-cnt set)]
     (cond
       (nil? roots)
       set

       (== (arrays/alength roots) 1)
       (AsyncBTSet. (arrays/aget roots 0) (inc cnt) cmp)

       :else
       (AsyncBTSet. (AsyncNode. (arrays/amap node-lim-key roots) roots)
                    (inc cnt)
                    cmp)))))

(defn async-disj
  ([set key]
   (dart/await (async-disj set key (.-comparator set))))
  ([set key cmp]
   (let [new-roots (dart/await (async-node-disj (.-root set) cmp key true nil nil))]
     (if (nil? new-roots)
       set
       (let [new-root (arrays/aget new-roots 0)
             cnt      (dec (.-cnt set))]
         (if (and (instance? AsyncNode new-root)
                  (== 1 (arrays/alength (.-pointers new-root))))
           ;; collapse root: promote single child
           (AsyncBTSet. (arrays/aget (.-pointers new-root) 0) cnt cmp)
           (AsyncBTSet. new-root cnt cmp)))))))

(defn async-lookup
  ([set key]     (dart/await (async-node-lookup (.-root set) (.-comparator set) key)))
  ([set key cmp] (dart/await (async-node-lookup (.-root set) cmp key))))

(defn async-slice
  "Returns a vector of all elements e where key-from <= e <= key-to.
   Pass nil for key-from or key-to for open-ended slices."
  ([set key-from key-to]
   (dart/await (async-slice set key-from key-to (.-comparator set))))
  ([set key-from key-to cmp]
   (if (zero? (.-cnt set))
     []
     (-> (dart/await (async-node-slice-into (.-root set) cmp key-from key-to (transient [])))
         persistent!))))
